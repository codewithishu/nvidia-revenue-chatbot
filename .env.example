# Copy to .env and fill in. NEVER commit .env.
LLM_PROVIDER=anthropic          # anthropic | openai  (openai also covers any OpenAI-compatible server via OPENAI_BASE_URL)
LLM_MODEL=                      # blank = provider default (see src/nvrag/llm.py)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

EMBED_MODEL=BAAI/bge-small-en-v1.5
USE_RERANKER=0                  # 1 = cross-encoder reranking (better precision, slower)
RERANK_MODEL=BAAI/bge-reranker-base
TOP_K=8
MIN_DENSE_SCORE=0.25            # below this best-cosine score, abstain without calling the LLM

DATA_DIR=data/raw
INDEX_DIR=index
MANIFEST_PATH=data/manifest.csv # optional per-file overrides: file,doc_type,year
OCR=0                           # 1 = OCR pages with no text layer (needs Tesseract installed)
